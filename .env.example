# Copy this file to .env and fill it in. .env is git-ignored.

# Free from https://www.themoviedb.org/settings/api
# Either the "API Key" or the "API Read Access Token" works.
TMDB_API_KEY=

# Your Letterboxd username. Your watchlist must be public.
LETTERBOXD_USERNAME=

# Two-letter country code for streaming catalogs.
WATCH_REGION=US

# Comma-separated TMDB provider names for the services you can watch on.
# Each name also covers its variants: "Netflix" includes
# "Netflix Standard with Ads", "Peacock Premium" includes "Peacock Premium Plus".
# Run ./watchlist_gaps.py --list-providers to see every name in your region.
STREAMING_SERVICES=Netflix, Hulu
